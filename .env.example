# Cascade service credentials. Copy to .env; never commit real keys.
# Local UI, editing, and export can start without service credentials.

# Transcription (Deepgram)
DEEPGRAM_API_KEY=

# Optional automatic clip mining via OpenAI Responses API.
# Also set generation.provider = "openai" and generation.openai_model in config.toml.
# Codex sign-in does not supply this key; API usage is billed separately.
OPENAI_API_KEY=

# Alternative generation.provider = "claude_cli" uses an authenticated Claude CLI,
# not an ANTHROPIC_API_KEY. See README.md for generation setup.

# Optional render scratch storage (absolute path)
CASCADE_RENDER_SCRATCH_ROOT=

# Optional Upload-Post publishing (connect your destination accounts there)
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=

# Optional Cloudflare R2 hosted media and video podcast RSS
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
