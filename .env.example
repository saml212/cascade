# Cascade — API Keys
# Copy this file to .env and fill in your keys

# ── Required ──────────────────────────────────────────────────────────────────

# Anthropic API key (Claude — clip mining)
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Deepgram API key (Nova-3 transcription + speaker diarization)
# Get one at: https://console.deepgram.com/
DEEPGRAM_API_KEY=

# ── Optional: Local Render Storage ───────────────────────────────────────────
# Absolute directory for temporary render intermediates (defaults to macOS cache)
CASCADE_RENDER_SCRATCH_ROOT=

# ── Optional: Publishing ─────────────────────────────────────────────────────
# Only needed if you use the publish agent

# YouTube Data API
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# TikTok API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram / Facebook API
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# ── Optional: Apple video podcast RSS (Cloudflare R2) ────────────────────────
# Only needed for Apple video podcast RSS publishing

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── Optional: Upload-Post Publishing ─────────────────────────────────────────
# Only needed if you use the publish agent with Upload-Post

UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=
